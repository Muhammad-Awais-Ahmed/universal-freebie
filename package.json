{
  "name": "universal-freebie",
  "version": "1.0.0",
  "description": "Universal Freebie - Game download manager (Electron + Next.js)",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Universal Freebie",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "set NODE_ENV=development&& electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && set NODE_ENV=development&& electron .\"",
    "package": "next build && electron-builder --win",
    "package:dir": "next build && electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "1.0.0-rc.12",
    "electron-serve": "^1.1.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "webtorrent": "^1.9.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.universal.freebie",
    "productName": "Universal Freebie",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "src/backend/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@next/swc-win32-x64-msvc/**/*",
      "node_modules/bufferutil/**/*",
      "node_modules/utf-8-validate/**/*",
      "node_modules/utp-native/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
